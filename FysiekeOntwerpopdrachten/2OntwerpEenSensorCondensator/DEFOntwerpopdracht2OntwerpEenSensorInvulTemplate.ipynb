    "A = 0.1*0.1 # [m^2]\n",
    "d = 0.001   # [m]\n",
    "epsilon_r  = 2.5\n",
    "\n",
    "C = capaciteit_plaatcondensator(A, d, epsilon_r)\n",
    "\n",
    "\n",
    "print(f\"Berekende capaciteit plaatcondensator groep 16 is {C * 1e12:.1f} pF\")\n",
    "\n"
   ]
